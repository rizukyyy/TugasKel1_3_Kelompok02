        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph ENV1[\&quot;Perangkat Pengguna\&quot;]\n        B[\&quot;Browser Pengguna\&quot;]\n    end\n\n    subgraph ENV2[\&quot;Server Aplikasi - Cloud Kampus\&quot;]\n        W[\&quot;Server Web dan API\&quot;]\n        Q[\&quot;Antrean Pesan\&quot;]\n        WP[\&quot;Worker Pencatatan Presensi\&quot;]\n        WN[\&quot;Worker Notifikasi\&quot;]\n    end\n\n    subgraph ENV3[\&quot;Server Data Kampus\&quot;]\n        DB[(\&quot;Basis Data Izin dan Sakit\&quot;)]\n        FS[(\&quot;Penyimpanan Berkas Bukti\&quot;)]\n    end\n\n    subgraph ENV4[\&quot;Server Presensi Kampus\&quot;]\n        LP[\&quot;Layanan Presensi\&quot;]\n        DP[(\&quot;Basis Data Presensi\&quot;)]\n    end\n\n    subgraph ENV5[\&quot;Layanan Eksternal\&quot;]\n        EM[\&quot;Layanan Email dan Notifikasi\&quot;]\n    end\n\n    B --&gt;|\&quot;HTTPS\&quot;| W\n    W --&gt;|\&quot;SQL\&quot;| DB\n    W --&gt;|\&quot;Akses berkas\&quot;| FS\n    W --&gt;|\&quot;Kirim pesan\&quot;| Q\n\n    Q --&gt;|\&quot;Konsumsi pesan\&quot;| WP\n    Q --&gt;|\&quot;Konsumsi pesan\&quot;| WN\n\n    WP --&gt;|\&quot;HTTPS API\&quot;| LP\n    LP --&gt;|\&quot;SQL\&quot;| DP\n    WP --&gt;|\&quot;SQL: perbarui status pencatatan\&quot;| DB\n\n    WN --&gt;|\&quot;SMTP atau API\&quot;| EM\n\n    subgraph TIM[\&quot;Penugasan Modul ke Tim\&quot;]\n        direction LR\n\n        T1[\&quot;Tim 1: Antarmuka Pengajuan, Antarmuka Persetujuan, Antarmuka Status dan Riwayat\&quot;]\n\n        T2[\&quot;Tim 2: Pengelola Pengajuan, Validasi Pengajuan, Pengelola Bukti\&quot;]\n\n        T3[\&quot;Tim 3: Alur Persetujuan, Pencatat Presensi, Notifikasi\&quot;]\n\n        T4[\&quot;Tim 4: Akses Data Izin, Akses Data Presensi, Penyimpanan Berkas\&quot;]\n\n        T1 ~~~ T2\n        T2 ~~~ T3\n        T3 ~~~ T4\n    end\n\n    ENV2 ~~~ TIM&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="3